PORT=4000
SESSION_SECRET=replace_with_a_long_random_string
NODE_ENV=development
# School teacher access code. Set this in your real .env — never put it in frontend code.
TEACHER_ACCESS_CODE=CHANGE_ME_SET_IN_DOTENV
# Administrator bootstrap (created on server start if missing). Set strong values in .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
